{
  "name": "kernel",
  "private": true,
  "contributors": [
    "dcousins",
    "azenderowska",
    "jsawczyszyn"
  ],
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cmp": "dxp-next cmp dev-ui ./dxp/component-service",
    "server": "npx wait-on tcp:5555 && node server.js",
    "dev": "concurrently --kill-others \"npm run cmp\" \"npm run server\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --ssrManifest",
    "build:server": "vite build --ssr src/entry-server.js",
    "test": "vitest --coverage",
    "lint:css": "stylelint \"**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "lint:css:fix": "stylelint \"**/*.scss\" --fix",
    "prettier": "npx prettier .",
    "prettier:fix": "npx prettier . --write",
    "deploy": "npm run deploy:component --",
    "deploy:component": "FEATURE_EDGE_COMPONENTS=true dxp-next cmp deploy ./dxp/component-service/$npm_config_name",
    "vermgmt": "vermgmt",
    "lint:js": "eslint dxp/component-service src/scripts \"dxp/utils/**/*.ts\"",
    "lint:js:fix": "eslint dxp/component-service src/scripts \"dxp/utils/**/*.ts\" --fix",
    "fix:all": "npm run lint:css:fix && npm run lint:js:fix && npm run prettier:fix"
  },
  "devDependencies": {
    "@squiz/component-lib": "^1.78.1",
    "@vitest/coverage-v8": "^3.0.8",
    "autoprefixer": "^10.4.20",
    "compression": "^1.7.4",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "express": "^4.19.2",
    "glob": "^11.0.0",
    "globals": "^15.14.0",
    "happy-dom": "^15.11.7",
    "kill-port": "^2.0.1",
    "sass": "^1.79.5",
    "sirv": "^2.0.4",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "tailwindcss": "^4.0.11",
    "typescript": "~5.8",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.2.0",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-sass-glob-import": "^5.0.0",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "@squiz/vermgmt": "^1.0.2",
    "@tailwindcss/vite": "^4.0.11",
    "node-html-parser": "^6.1.13",
    "stylelint-selector-bem-pattern": "^4.0.1",
    "vite-plugin-static-copy": "^2.2.0",
    "wait-on": "^8.0.4",
    "xss": "^1.0.15"
  }
}
