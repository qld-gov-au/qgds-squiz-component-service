BASE_DOMAIN="https://canary-us.uat.matrix.squiz.cloud/"
BASE_PATH="dxp-comp-lib/_api/components/"
API_IDENTIFIER="api-identifier"

# Set to "true" for local dev (npm run dev:dxp). Page title, page last updated, breadcrumbs and the
# header show their mock preview content only when this is true and the component has no placement.
IS_LOCAL="true"

# Set to "true" to emit [CMP DEBUG] phased timing logs from edge components (see README).
CMP_DEBUG_TIMING="false"