<!-- QGDS Component: Textbox -->

<label class="qld-text-input-label {{#if isRequired}}field-required{{/if}} {{#if isDisabled}}field-disabled{{/if}}"
    for="{{id}}">
    <sq-field style="display: contents;" data-sq-field="label-text">{{label-text}}</sq-field>
    {{#if optional-text}}
    <span class="label-text-optional">(<sq-field style="display: contents;" data-sq-field="optional-text">{{optional-text}}</sq-field>)</span>
    {{/if}}
</label>

{{#if hint-text}}
<span class="qld-hint-text" id="{{id}}-hint" data-sq-field="hint-text">{{hint-text}}</span>
{{/if}}

{{#contains "qld-input-success" customClass}}{{! legacy support for feedback classes `qld-input-success`}}
<span class="qld-input-success" data-sq-field="successMessageText">{{successMessageText}}</span>
{{else}}
{{#if successMessageText}}{{! updated bootstrap style classes - `valid-feedback`}}
<div class="valid-feedback" data-sq-field="successMessageText">{{successMessageText}}</div>
{{/if}}{{/contains}}

{{#contains "qld-input-error" customClass}}{{! legacy support for feedback classes `qld-input-error`}}
<span class="qld-input-error" data-sq-field="errorMessageText">{{errorMessageText}}</span>
{{else}}
{{#if errorMessageText}}{{! updated bootstrap style classes - `invalid-feedback`}}
<div class="invalid-feedback" data-sq-field="errorMessageText">{{errorMessageText}}</div>
{{/if}}{{/contains}}

<input id={{id}} {{#if value}}value="{{value}}"{{/if}}  class="form-control {{customClass}} {{#if isFilled}}is-filled{{/if}} {{#if isValid}}is-valid{{else}}{{#ifCond isValid "===" false}}is-invalid{{/ifCond}}{{/if}}"
    type="text" placeholder="{{placeholder}}" tabindex="0" {{#if isDisabled}}disabled{{/if}} {{#if
    isRequired}}required{{/if}} {{#if hint-text}}aria-describedby="{{id}}-hint"{{/if}} />