<a class="qld-cta-link {{getClassNames "small, view-all" class}}"
    {{#if id}}id="{{id}}"{{/if}}
    href="{{href}}"
    target="{{target}}"
    {{#if arialabel}}aria-label="{{arialabel}}"{{/if}}
    >
     <sq-field style="display: contents;" data-sq-field="label">{{label}}</sq-field>
    <span class="icon" aria-hidden="true"></span>
</a>