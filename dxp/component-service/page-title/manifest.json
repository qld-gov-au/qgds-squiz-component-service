{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "version": "0.1.1",
  "name": "page-title",
  "displayName": "Page title",
  "namespace": "qgds-bs5",
  "icon": {
    "id": "title",
    "color": {
      "type": "hex",
      "value": "#6bbe27"
    }
  },
  "description": "Outputs the current page name wrapped in an h1. The name is taken from the page the component is placed on.",
  "environment": [
    {
      "name": "API_IDENTIFIER",
      "required": false
    },
    {
      "name": "BASE_DOMAIN",
      "required": false
    },
    {
      "name": "BASE_PATH",
      "required": false
    },
    {
      "name": "MX_API",
      "required": false
    },
    {
      "name": "BEARER_AUTH",
      "required": false
    },
    {
      "name": "IS_LOCAL",
      "required": false
    }
  ],
  "mainFunction": "main",
  "type": "edge",
  "functions": [
    {
      "name": "main",
      "entry": "main.ts",
      "input": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "staticFiles": {
    "locationRoot": "./"
  },
  "previews": {
    "default": {
      "functionData": {
        "main": {
          "inputData": {
            "type": "file",
            "path": "example.data.json"
          },
          "wrapper": {
            "path": "preview.html"
          }
        }
      }
    }
  }
}
