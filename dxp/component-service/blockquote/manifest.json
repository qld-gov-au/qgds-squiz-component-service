{
  "$schema": "http://localhost:3000/schemas/v1.json#",
  "version": "0.1.0",
  "name": "blockquote",
  "displayName": "Blockquote Component",
  "description": "QGDS Bootstrap 5 - Blockquote Component",
  "namespace": "qgds-bs5",
  "icon": {
    "id": "format_quote",
    "color": {
      "type": "hex",
      "value": "#6bbe27"
    }
  },
  "mainFunction": "main",
  "type": "edge",
  "functions": [
    {
      "name": "main",
      "entry": "main.js",
      "input": {
        "type": "object",
        "properties": {
          "wrapperClasses": {
            "type": "string",
            "title": "Wrapper classes",
            "default": ""
          },
          "citeUrl": {
            "type": "string",
            "title": "Quote's URL"
          },
          "content": {
            "type": "string",
            "title": "Quote",
            "ui:metadata": {
              "inlineEditable": true
            }
          },
          "citeText": {
            "type": "string",
            "title": "Quote's author",
            "ui:metadata": {
              "inlineEditable": true
            }
          },
          "classes": {
            "type": "string",
            "title": "Additional CSS classes"
          }
        },
        "required": ["content"]
      },
      "output": {
        "responseType": "html"
      }
    }
  ],
  "previews": {
    "default": {
      "functionData": {
        "main": {
          "inputData": {
            "type": "file",
            "path": "example.data.json"
          },
          "wrapper": {
            "path": "preview.html"
          }
        }
      }
    }
  },
  "staticFiles": {
    "locationRoot": "./"
  }
}
